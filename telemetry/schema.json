{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nik1tsyganov/magi/telemetry/schema.json",
  "title": "MAGI dispatch telemetry row",
  "description": "Lead-written MAGI Cursor dispatch row (tools/telemetry-append.js). This is not the Conclave/Claude-host hook log. See telemetry/README.md for the adapter contract; no join key is defined.",
  "type": "object",
  "required": ["vendor", "role", "hostMode", "routedBy"],
  "additionalProperties": true,
  "properties": {
    "vendor": {
      "type": "string",
      "enum": ["anthropic", "openai", "google"]
    },
    "role": {
      "type": "string",
      "enum": ["implement", "verify", "review"]
    },
    "hostMode": {
      "type": "string",
      "enum": ["cursor", "cursor-cli", "synara"]
    },
    "routedBy": {
      "type": "string",
      "const": "arbiter"
    },
    "capturedBy": {
      "type": "string",
      "const": "lead"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "UTC calendar date. Invalid calendar dates (e.g. 2026-02-30) are rejected at validate time."
    },
    "vendorSideTokens": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "null" }
      ]
    },
    "totalTokens": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "null" }
      ]
    }
  }
}
