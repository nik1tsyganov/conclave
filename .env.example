# CONCLAVE runtime environment. Copy to ~/.config/conclave/env.sh and source it before any tool.
#
# This file is the canonical list. The README points here rather than repeating it, so the two
# cannot drift. Paths are examples; nothing here is read from this file at runtime.

# ── Vendor CLIs. A panel needs two; three gives full independence. ──────────────
export CONCLAVE_CODEX_BIN="$HOME/.local/bin/codex"
export CONCLAVE_AGY_BIN="$HOME/.local/bin/agy"
export CONCLAVE_CLAUDE_BIN="$HOME/.local/bin/claude"

# Headless Codex otherwise routes through a local proxy that may not be listening.
export CONCLAVE_CODEX_PROVIDER="openai"

# ── Where a seat is allowed to write. A run refuses a workspace outside these. ──
export CONCLAVE_ALLOWED_WORKSPACE_ROOTS="$HOME/.local/scratch/conclave:/private/tmp/conclave"

# ── The standing-rules pack. OPTIONAL. ─────────────────────────────────────────
# STANDING v2 + R01-R22 ship at <checkout>/standing-rules and are used by default.
# Set this only to replace that pack wholesale. A root that is named and unreadable
# STOPS the run rather than falling back to the shipped copy.
# export CONCLAVE_RULES_ROOT="$HOME/src/some-other-rules"

# ── The arbiter. OPTIONAL, but the seal refuses without it unless an opt-out
#    reason is recorded. Jev is TypeSafe System One.
export TYPESAFE_API_KEY="..."

# ── Vault, field library and skills roots. OPTIONAL, and owner-local.
#    These point at PRIVATE repositories. Sealing and driving a run do not read
#    them; telemetry, skill-sync and the vault index do, and refuse without them.
export CONCLAVE_VAULT_ROOT="$HOME/src/ai-ops-vault"
export CONCLAVE_FIELD_LIBRARY_ROOT="$HOME/src/field-library"
export CONCLAVE_VAULT_SKILLS_ROOT="$HOME/src/vault-skills"
