{
  "name": "conclave-cursor-plugin",
  "version": "0.1.1",
  "type": "commonjs",
  "description": "Code-enforced CONCLAVE tri-vendor Cursor and CLI runtime",
  "bin": {
    "conclave-mcp": "mcp/server.js",
    "conclave-panel": "tools/conclave-panel.js"
  },
  "scripts": {
    "test": "node --test \"tools/*.test.js\" \"mcp/*.test.js\" \"hosts/*/*.test.js\"",
    "check": "npm test && node tools/release-check.js",
    "check:cross-repo": "node tools/cross-repo-check.js",
    "dashboard": "node tools/conclave-dashboard.js",
    "drive": "node tools/run-drive.js",
    "package": "node tools/npm-package.js --out dist/conclave-mcp",
    "publish:mcp": "npm run package && npm publish ./dist/conclave-mcp --access public"
  },
  "keywords": [
    "conclave",
    "multi-vendor",
    "cursor",
    "dispatch"
  ],
  "author": "Nikita Tsyganov",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/nik1tsyganov/conclave.git",
  "private": true,
  "files": [
    "mcp/server.js",
    "tools/dispatch-schema.js",
    "tools/panel-rules.js",
    "tools/panel-routing.js",
    "tools/panel-block.js",
    "tools/conclave-panel.js",
    "LICENSE",
    "ADDITIONAL-TERMS.md"
  ]
}
